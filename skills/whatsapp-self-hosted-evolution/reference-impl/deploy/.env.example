# Evolution API env template. Copy to evolution/.env for local `docker compose`,
# and set the same values in the Render service's Environment tab for prod.
# NEVER commit a filled-in .env (it's gitignored).

# Long random admin key. This is BOTH:
#   - Evolution's AUTHENTICATION_API_KEY (below), AND
#   - billing-server's EVOLUTION_API_KEY (set that in the billing-server env).
# Generate: openssl rand -hex 32
EVOLUTION_API_KEY=replace-with-openssl-rand-hex-32

# Public URL of the Evolution service.
#   local:  http://localhost:8080
#   prod:   https://evolution.example.com (or the Render *.onrender.com URL)
EVOLUTION_SERVER_URL=http://localhost:8080

# Postgres connection string (sessions live here - use a MANAGED, BACKED-UP DB).
#   local:  postgresql://postgres:postgres@postgres:5432/evolution
#   prod:   the Render Postgres "Internal Connection String"
DATABASE_URL=postgresql://user:pass@host:5432/evolution

# Redis connection string.
#   local:  redis://redis:6379
#   prod:   the Render Key-Value (Redis) connection string
CACHE_REDIS_URI=redis://redis:6379
